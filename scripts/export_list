#===================================================================================================
# Mikrotik creates records on the SFTP server from the specified dynamic tiles for the current date
#===================================================================================================

:local date [/system/clock/get date]
:local time [/system/clock/get time]
:local stamp ("$date  $time")

:local list {"dns_flood";"port_scanners";"wan_ddos_blacklist";"black_list_winbox"}

:foreach i in=$list do={

    # delete old file
    /file remove [/file/find name=("$i.txt")]

    # create emty file
    :local f [/file/add name=("$i.txt") contents=""]

    # iterating over the addresses of the current list
    :foreach x in=[/ip/firewall/address-list/find where list=$i] do={

        :local ct [/ip/firewall/address-list/get $x creation-time]
        :local createdDate [:pick $ct 0 10]
        :local addr [/ip/firewall/address-list/get $x address]

        # take addresses created today
        :if ($createdDate = $date) do={
            :local old [/file/get $f contents]
            /file/set $f contents=($old . $addr . "\r\n")
        }
    }

    :delay 500ms

    # sftp
    /tool/fetch address= mode=sftp user= password= src-path="$i.txt" dst-path="/mnt/data/mikrotik_exp/$i_$stamp.txt" upload=yes

    # after successful submission:
    /file/remove $f
}


#==============================================================================================
# mikrotik creates records on the SFTP server from the specified dynamic sheets with all dates
#==============================================================================================

:local date [/system/clock/get date]
:local time [/system/clock/get time]
:local stamp ("$date $time")

:local list {"dns_flood";"port_scanners";"wan_ddos_blacklist";"black_list_winbox"}


:foreach i in=$list do={
    /ip/firewall/address-list/print file=$i where list=$i

    :local f [/file/find name=("$i.txt")]

    :while ([:len $f] = 0) do={
        :delay 100ms
        :set f [/file/find name=("$i.txt")]
    }

    # SFTP
    /tool/fetch address= mode=sftp user= password= src-path="$i.txt" dst-path="/mnt/data/mikrotik_exp/$i_$stamp.txt" upload=yes

    /file/remove $f
}
